{
	"name": "fieldstock-asset-management",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
		"dev:client": "vite --host 0.0.0.0",
		"dev:server": "node --env-file-if-exists=.env --watch server/index.js",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env server/index.js"
	},
	"dependencies": {
		"express": "^5.1.0",
		"jsonwebtoken": "^9.0.2",
		"lucide-react": "^0.468.0",
		"mysql2": "^3.24.5",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^9.2.0",
		"vite": "^6.3.5"
	}
}
